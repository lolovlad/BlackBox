#!/usr/bin/env sh
set -eu

PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
COMPOSE_FILE="$PROJECT_ROOT/deploy/compose.yaml"
COMPOSE_OVERRIDE="${BB_COMPOSE_OVERRIDE:-}"
PROFILE="${BB_PROFILE:-dev}"

compose() {
  if [ -n "$COMPOSE_OVERRIDE" ]; then
    case "$COMPOSE_OVERRIDE" in
      /*) override_file="$COMPOSE_OVERRIDE" ;;
      *) override_file="$PROJECT_ROOT/$COMPOSE_OVERRIDE" ;;
    esac
    docker compose --project-directory "$PROJECT_ROOT" \
      --file "$COMPOSE_FILE" --file "$override_file" --profile "$PROFILE" "$@"
  else
    docker compose --project-directory "$PROJECT_ROOT" \
      --file "$COMPOSE_FILE" --profile "$PROFILE" "$@"
  fi
}

compose_profiles() {
  if [ -n "$COMPOSE_OVERRIDE" ]; then
    case "$COMPOSE_OVERRIDE" in
      /*) override_file="$COMPOSE_OVERRIDE" ;;
      *) override_file="$PROJECT_ROOT/$COMPOSE_OVERRIDE" ;;
    esac
    docker compose --project-directory "$PROJECT_ROOT" \
      --file "$COMPOSE_FILE" --file "$override_file" --profile dev --profile build "$@"
  else
    docker compose --project-directory "$PROJECT_ROOT" \
      --file "$COMPOSE_FILE" --profile dev --profile build "$@"
  fi
}

usage() {
  cat <<'EOF'
Usage: ./bbctl <command>

Commands:
  up       Build and start the current lab profile
  down     Stop the current lab profile
  update   Stash local tracked changes, pull, rebuild, start and smoke-test
  smoke    Run the Hub login/VM/Parquet/WebSocket acceptance smoke test
  logs     Follow service logs
  ps       Show Compose service state
  help     Show this help

Environment:
  BB_PROFILE    Compose profile (default: dev)
  BB_HUB_PORT   Hub HTTP port (default: 8080)
  BB_COMPOSE_OVERRIDE  Optional Compose override, e.g. deploy/compose.pi.yaml
EOF
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "ERROR: docker is required" >&2
    exit 1
  fi
  docker compose version >/dev/null
}

remove_dynamic_workers() {
  worker_ids="$(docker ps -aq --filter 'label=bb.vm_id')"
  if [ -n "$worker_ids" ]; then
    echo "Removing dynamic BlackBox workers so they are recreated from the current images..."
    # The filter is deliberately restricted to the label assigned by Hub.
    # Named volumes (including blackbox-data) are not touched.
    docker rm -f $worker_ids >/dev/null
  fi
}

git_fast_forward() {
  if ! git -C "$PROJECT_ROOT" diff --quiet || ! git -C "$PROJECT_ROOT" diff --cached --quiet; then
    echo "Stashing local tracked changes so git pull can fast-forward..."
    git -C "$PROJECT_ROOT" stash push -m "bbctl-update autostash"
    echo "Local changes kept in git stash. Inspect with: git stash list"
  fi
  git -C "$PROJECT_ROOT" pull --ff-only
  chmod +x "$PROJECT_ROOT/bbctl" || true
}

smoke() {
  if [ "$PROFILE" = "legacy" ]; then
    port="${BB_HTTP_PORT:-5000}"
    if curl --fail --silent "http://127.0.0.1:${port}/" >/dev/null 2>&1; then
      echo "Legacy smoke check passed: http://127.0.0.1:${port}/"
      return 0
    fi
    echo "ERROR: legacy web endpoint is not ready on port ${port}" >&2
    return 1
  fi
  port="${BB_HUB_PORT:-8080}"
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    if curl --fail --silent "http://127.0.0.1:${port}/healthz" >/dev/null 2>&1; then
      compose exec -T hub /app/.venv/bin/python -m services.hub.smoke --url "http://127.0.0.1:8080" --data-root /data
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  echo "ERROR: Hub did not become ready on port ${port}" >&2
  return 1
}

command="${1:-help}"
case "$command" in
  help|-h|--help)
    usage
    ;;
  up)
    require_docker
    compose_profiles build
    compose up --detach --build
    ;;
  down)
    require_docker
    compose stop
    remove_dynamic_workers
    compose down
    ;;
  update)
    require_docker
    if [ "${BBCTL_UPDATE_APPLY:-}" != "1" ]; then
      git_fast_forward
      BBCTL_UPDATE_APPLY=1 exec "$PROJECT_ROOT/bbctl" update
    fi
    compose_profiles build --pull
    compose stop
    remove_dynamic_workers
    compose down
    compose up --detach --remove-orphans
    smoke
    ;;
  smoke)
    require_docker
    smoke
    ;;
  logs)
    require_docker
    compose logs --follow
    ;;
  ps)
    require_docker
    compose ps
    ;;
  *)
    echo "ERROR: unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
