# vNext Hub Compose settings
BB_HUB_PORT=8080
BB_JWT_SECRET=replace-with-a-long-random-secret
BB_BOOTSTRAP_ADMIN_USERNAME=admin
BB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
BB_COOKIE_SECURE=0
# Optional image overrides for a registry/lab build:
# BB_WORKER_IMAGE_RTU=blackbox/worker-modbus-rtu:dev
# BB_WORKER_IMAGE_TCP=blackbox/worker-modbus-tcp:dev
# BB_WORKER_IMAGE_SIMULATOR=blackbox/worker-simulator:dev

# Optional explicit host read resources when Hub runs in a container.
# Host /dev is bind-mounted into Hub as /host-dev; scan publishes /dev/ttyAMA* paths.
# BB_DISCOVERY_SERIAL_PATHS=/dev/ttyUSB0
# BB_DISCOVERY_TCP_ENDPOINTS=192.168.1.50:502

# Optional SSD override (use deploy/compose.pi.yaml with bbctl):
# BB_EXTERNAL_STORAGE_HOST_PATH=/mnt/blackbox-ssd
# BB_STORAGE_PATHS=ssd=/external-storage

# Legacy fallback only
BB_HTTP_PORT=5000
SECRET_KEY=replace-in-lab
